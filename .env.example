# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional: the site's public address, used for QR codes and sign-up email links.
# Without it the address is taken from the request, which works on Vercel.
# NEXT_PUBLIC_SITE_URL=https://pickle-rating.vercel.app
